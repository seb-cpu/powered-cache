{
  "name": "swiftpress/swiftpress",
  "description": "Lightweight WordPress performance optimization — page caching, file optimization, font optimization, and intelligent cache preloading.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "SwiftPress",
      "email": "support@swiftpress.dev",
      "homepage": "https://swiftpress.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "SwiftPress\\": "includes/classes/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "10up/wp_mock": "dev-trunk",
    "10up/phpcs-composer": "dev-master",
    "coenjacobs/mozart": "^0.7.1",
    "matthiasmullie/minify": "^1.3",
    "deliciousbrains/wp-background-processing": "dev-master#be0a5e62f2c1e7603ebe3dea75f91102f1a2c1cb",
    "voku/html-min": "^4.5"
  },
  "scripts": {
    "lint": "phpcs swiftpress.php uninstall.php ./includes -s",
    "lint-fix": "phpcbf swiftpress.php uninstall.php ./includes",
    "setup-local-tests": "bash bin/install-wp-tests.sh swiftpress_test root root localhost trunk true",
    "post-install-cmd": [
      "\"vendor/bin/mozart\" compose",
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "\"vendor/bin/mozart\" compose",
      "composer dump-autoload"
    ]
  },
  "extra": {
    "mozart": {
      "dep_namespace": "SwiftPress\\Dependencies\\",
      "dep_directory": "/includes/classes/Dependencies/",
      "classmap_directory": "/includes/package/",
      "classmap_prefix": "SwiftPress_",
      "packages": [
        "matthiasmullie/minify",
        "deliciousbrains/wp-background-processing",
        "voku/html-min"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
